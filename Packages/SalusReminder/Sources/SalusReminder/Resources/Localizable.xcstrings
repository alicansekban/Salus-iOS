      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Background App Refresh is off — the reminder list is only refreshed while the app is open."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arka plan yenilemesi kapalı — hatırlatıcı listesi yalnızca uygulamayı açtığınızda tazelenir."
          }
        }
      }
    },
    "reminder_problem_full_screen_denied" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Medication alarms cannot take over the screen — a dose still arrives as a notification with sound, but no alarm opens on the lock screen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İlaç alarmları ekranı kaplayamıyor — doz saati geldiğinde sesli bildirim gelir, ama kilit ekranında alarm açılmaz."
          }
        }
      }
    },
