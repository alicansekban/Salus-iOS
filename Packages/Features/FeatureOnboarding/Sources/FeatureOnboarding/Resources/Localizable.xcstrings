    "onboarding_sex_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We need this to tailor your health experience and cycle tracking. Your data is stored on this device only."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Size en uygun sağlık deneyimini ve döngü takibini sunabilmemiz için bu bilgiye ihtiyacımız var. Verileriniz yalnızca bu cihazda saklanır."
          }
        }
      }
    },
