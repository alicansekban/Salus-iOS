    "onboarding_welcome_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Step into a personal space built around your privacy, where you can follow your health calmly and with confidence."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sağlığınızı güvenle ve huzurla takip edebileceğiniz, gizliliğinizi merkeze alan kişisel alanınıza adım atın."
          }
        }
      }
    },
    "onboarding_name_title" : {
