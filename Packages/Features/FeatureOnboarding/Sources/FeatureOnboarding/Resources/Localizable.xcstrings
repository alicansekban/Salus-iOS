    },
    "onboarding_notes_title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Extra health notes"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ek Sağlık Notları"
          }
        }
      }
    },
    "onboarding_notes_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add past conditions, allergies or anything else about your health that you want your doctor to know."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doktorunuzun bilmesini istediğiniz geçmiş rahatsızlıklar, alerjiler veya genel sağlık durumunuzla ilgili özel notlarınızı buraya ekleyebilirsiniz."
          }
        }
      }
    },
    "onboarding_notes_label" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notes"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notlar"
          }
        }
      }
    },
    "onboarding_notes_placeholder" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "e.g. I hurt my knee slightly in 2018. It aches after exercise. I am allergic to penicillin."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Örn: 2018'de hafif bir diz sakatlığı geçirdim. Bazen egzersiz sonrası ağrı yapıyor. Penisilin alerjim var."
          }
        }
      }
    },
    "onboarding_notes_private" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On this device only"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca bu cihazda"
          }
        }
      }
    },
    "onboarding_notes_privacy_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your health notes are stored on this device only; your health records are never sent to a server and never shared with third parties. Salus uses the network only to verify your subscription and — if you use them — for the AI features, which only ever receive anonymous statistical summaries."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sağlık notlarınız yalnızca bu cihazda saklanır; sağlık kayıtlarınız hiçbir sunucuya gönderilmez ve üçüncü taraflarla paylaşılmaz. Salus ağı yalnızca aboneliğinizi doğrulamak için ve — kullanırsanız — AI özellikleri için kullanır; AI özelliklerine yalnızca anonim istatistik özetleri gönderilir."
          }
        }
      }
    },
    "onboarding_notifications_title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notification permission"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bildirim İzinleri"
          }
        }
      }
    },
    "onboarding_notifications_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Let us send you gentle reminders so you do not forget your medications and health check-ups. If you decline, the app keeps working — you can grant it later under More › Reminders."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İlaçlarınızı ve sağlık kontrollerinizi unutmamanız için size nazik hatırlatıcılar gönderelim. İzin vermezseniz uygulama çalışmaya devam eder; izni sonradan Daha Fazla › Hatırlatıcılar bölümünden verebilirsiniz."
          }
        }
      }
    },
    "onboarding_notifications_benefit_title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On-time reminders"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zamanında Hatırlatma"
          }
        }
      }
    },
    "onboarding_notifications_benefit_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Never miss a dose."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asla bir dozu kaçırmayın."
          }
        }
      }
    },
    "onboarding_notifications_later" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Later"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daha Sonra"
          }
        }
      }
    }
  },
  "version" : "1.0"
