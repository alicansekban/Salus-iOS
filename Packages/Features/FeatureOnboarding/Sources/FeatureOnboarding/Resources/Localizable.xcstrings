    "onboarding_weight_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saved as your first measurement, so your weight chart starts today."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İlk ölçümünüz olarak kaydedilir ve kilo grafiğinizin başlangıcı olur."
          }
        }
      }
    },
    "onboarding_weight_label" : {
      "extractionState" : "manual",
      "localizations" : {
