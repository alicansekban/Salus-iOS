        }
      }
    },
    "onboarding_notes_placeholder" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "e.g. I hurt my knee slightly in 2018. It aches after exercise. I am allergic to penicillin."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Örn: 2018'de hafif bir diz sakatlığı geçirdim. Bazen egzersiz sonrası ağrı yapıyor. Penisilin alerjim var."
