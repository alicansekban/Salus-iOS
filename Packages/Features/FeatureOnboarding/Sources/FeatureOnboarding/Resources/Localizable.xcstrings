    "onboarding_health_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add anything you want your doctor to know and turn on reminders. You can change both later."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doktorunuzun bilmesini istediğiniz notları ekleyin ve hatırlatıcıları açın. İkisini de sonradan değiştirebilirsiniz."
          }
        }
      }
    },
    "onboarding_notes_label" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HEALTH NOTES & ALLERGIES (OPTIONAL)"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SAĞLIK NOTLARI & ALERJİLER (İSTEĞE BAĞLI)"
