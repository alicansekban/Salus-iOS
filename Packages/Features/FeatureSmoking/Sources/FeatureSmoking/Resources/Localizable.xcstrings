          }
        }
      }
    },
    "smoking_stage_h_1mo_statement" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coughing and shortness of breath decrease (1–9 months)."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öksürük ve nefes darlığı azalır (1–9 ay)."
