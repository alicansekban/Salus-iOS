          "stringUnit" : {
            "state" : "translated",
            "value" : "20 minutes · Heart rate and blood pressure"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "20 dakika · Nabız ve tansiyon"
          }
        }
      }
    },
    "smoking_stage_h_2w_statement" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Circulation improves and lung function increases (2–12 weeks)."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dolaşım düzelir ve akciğer işlevi artar (2–12 hafta)."
          }
        }
      }
    },
    "smoking_stage_h_2w_title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
