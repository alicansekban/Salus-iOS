          "stringUnit" : {
            "state" : "translated",
            "value" : "48 hours · Taste and smell"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "48 saat · Tat ve koku"
          }
        }
      }
    },
    "smoking_stage_h_5y_statement" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stroke risk is reduced to that of a non-smoker 5 to 15 years after quitting."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İnme riski, bırakmanın üzerinden 5 ila 15 yıl geçtikten sonra sigara içmeyen bir kişininkine düşer."
          }
        }
      }
    },
