      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The risk of coronary heart disease is that of a non-smoker."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koroner kalp hastalığı riski, sigara içmeyen bir kişininkiyle aynı düzeydedir."
          }
        }
      }
    },
    "smoking_stage_h_15y_title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "15 years · Coronary heart disease risk"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "15 yıl · Koroner kalp hastalığı riski"
          }
        }
      }
    },
    "smoking_stage_h_1mo_statement" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coughing and shortness of breath decrease (1–9 months)."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öksürük ve nefes darlığı azalır (1–9 ay)."
          }
        }
      }
    },
    "smoking_stage_h_1mo_title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 month · Cough and shortness of breath"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 ay · Öksürük ve nefes darlığı"
          }
        }
      }
    },
    "smoking_stage_h_1y_statement" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The risk of coronary heart disease is about half that of a person who smokes."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koroner kalp hastalığı riski, sigara içen bir kişininkinin yaklaşık yarısıdır."
          }
        }
      }
    },
    "smoking_stage_h_1y_title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
