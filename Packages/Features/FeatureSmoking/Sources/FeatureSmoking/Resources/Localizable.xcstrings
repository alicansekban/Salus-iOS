          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2 hafta · Dolaşım ve akciğer işlevi"
          }
        }
      }
    },
    "smoking_stage_h_48h_statement" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The lungs clear out mucus, and the senses of taste and smell improve."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akciğerlerdeki balgam temizlenir, tat ve koku duyuları gelişir."
          }
        }
      }
    },
