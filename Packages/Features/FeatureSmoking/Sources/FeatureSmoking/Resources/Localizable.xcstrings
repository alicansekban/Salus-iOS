    },
    "smoking_stage_h_1y_statement" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The risk of coronary heart disease is about half that of a person who smokes."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koroner kalp hastalığı riski, sigara içen bir kişininkinin yaklaşık yarısıdır."
