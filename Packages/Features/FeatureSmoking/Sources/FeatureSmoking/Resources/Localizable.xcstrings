          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 yıl · Koroner kalp hastalığı riski"
          }
        }
      }
    },
    "smoking_stage_h_20m_statement" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heart rate and blood pressure drop."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nabız ve tansiyon düşer."
          }
        }
      }
    },
    "smoking_stage_h_20m_title" : {
      "extractionState" : "manual",
      "localizations" : {
