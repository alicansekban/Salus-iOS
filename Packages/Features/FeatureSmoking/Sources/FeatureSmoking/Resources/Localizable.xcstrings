        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "12 saat · Kandaki karbonmonoksit"
          }
        }
      }
    },
    "smoking_stage_h_15y_statement" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The risk of coronary heart disease is that of a non-smoker."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koroner kalp hastalığı riski, sigara içmeyen bir kişininkiyle aynı düzeydedir."
          }
        }
      }
    },
    "smoking_stage_h_15y_title" : {
      "extractionState" : "manual",
