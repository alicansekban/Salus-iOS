    "reminder_health_intro" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For reminders to arrive on time, Salus needs the settings below. All checks run on this device only — nothing leaves it."
