    "reminder_health_full_screen_ok" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Medication alarms will take over the lock screen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İlaç alarmları kilit ekranını kaplayarak çalacak."
          }
        }
      }
    },
    "reminder_health_full_screen_problem" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Medication alarms cannot take over the screen — a dose still arrives as a notification with sound, but no alarm opens on the lock screen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İlaç alarmları ekranı kaplayamıyor — doz saati geldiğinde sesli bildirim gelir, ama kilit ekranında alarm açılmaz."
          }
        }
      }
    },
    "reminder_health_full_screen_title" : {
      "extractionState" : "manual",
