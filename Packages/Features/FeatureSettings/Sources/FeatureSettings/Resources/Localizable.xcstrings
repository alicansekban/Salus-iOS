        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hatırlatıcıların zamanında gelmesi için Salus'un aşağıdaki ayarlara ihtiyacı var. Tüm kontroller yalnızca bu cihazda çalışır — hiçbir veri dışarı çıkmaz."
          }
        }
      }
    },
