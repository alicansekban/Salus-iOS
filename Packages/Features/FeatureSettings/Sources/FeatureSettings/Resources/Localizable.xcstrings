      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Background App Refresh is off — the reminder list is only refreshed while the app is open."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arka plan yenilemesi kapalı — hatırlatıcı listesi yalnızca uygulamayı açtığınızda tazelenir."
          }
        }
      }
    },
