    "trends_locked_message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See the patterns in your records: time-of-day spread, your metrics side by side, the share of recorded doses that were marked as taken, and how each metric changed from the previous period."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıtlarındaki örüntüleri gör: gün içi dağılım, metriklerin bir arada seyri, kaydedilen dozların alınma oranı ve her metriğin önceki döneme göre değişimi."
          }
        }
      }
    },
    "trends_locked_title": {
      "extractionState": "manual",
      "localizations": {
